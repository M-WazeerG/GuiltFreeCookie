# Copy to .env.production.local (git-ignored) or set in your build pipeline.

# The public address of the site. Canonical links, the sitemap, robots.txt
# and social share previews are all built on it.
VITE_SITE_URL=https://guiltfreecookie.co.za

# Where the browser reaches the API. Leave unset to use /guiltFreeCookie on
# the site's own domain (proxy it to Spring Boot), or give the full URL if
# the API has its own domain.
# VITE_API_BASE_URL=https://api.guiltfreecookie.co.za/guiltFreeCookie

# The API the build reads the catalogue from, so product pages are
# prerendered and listed in the sitemap. Only used at build time.
PRERENDER_API_URL=http://localhost:8080/guiltFreeCookie

# Where `npm run dev` and `npm run preview` forward /guiltFreeCookie calls.
# API_PROXY_TARGET=http://localhost:8080
